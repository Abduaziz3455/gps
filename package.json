{
  "name": "tbb-dispatcher",
  "version": "2.0.0",
  "description": "TBB Dispatcher: live fleet map, gate cameras, analytics and push notifications",
  "main": "server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "MOCK=1 node --disable-warning=ExperimentalWarning server.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\"",
    "user": "node --disable-warning=ExperimentalWarning scripts/user.js",
    "test:e2e": "playwright test",
    "test:e2e:real": "node test/e2e/run-real.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "web-push": "3.6.7"
  },
  "optionalDependencies": {
    "sharp": "0.35.5"
  },
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
