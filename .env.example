# TBB Dispatcher v2. Copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=8090
# The site's public address (used for the Origin check and in notifications)
PUBLIC_ORIGIN=https://tbb-gps.uz

# First owner account, created on the first start when there are no users yet.
# After that, manage people in Settings -> Users (or `npm run user`). You can remove these lines then.
OWNER_USERNAME=
OWNER_PASSWORD=

# GoGPS (baku.gps.az). Stays on the server; browsers never see it.
GPS_LOGIN=
GPS_PASSWORD=
# GPS_BASE_URL=https://baku.gps.az

# Hikvision NVR with the ANPR cameras .
# Address with port, e.g. http://87.192.249.151:8008. If the router restricts the NVR port to certain IPs,
# add this server's IP (5.182.26.55).
NVR_HOST=
NVR_USER=admin
NVR_PASSWORD=
# Cameras: default is the pairing verified on 12 Oct 2026 (ANPR-1 ch4 = entry with Yo'l-2 ch5,
# ANPR-2 ch3 = exit with Yo'l-1 ch6). Override only if the NVR channels change:
# CAMERAS_JSON=[{"channel":4,"name":"ANPR-1","direction":"in","contextChannel":5,"contextName":"Yo'l-2"},{"channel":3,"name":"ANPR-2","direction":"out","contextChannel":6,"contextName":"Yo'l-1"}]
# Days of camera history imported on the very first start (records only, no notifications)
CAMERA_BACKFILL_DAYS=30

# Top view: the photo showing the truck's load, read from the overview camera's recording with ffmpeg (RTSP port 554).
# NVR_RTSP_PORT=554
# TOP_VIEW=0 turns it off; TOP_VIEW_WORKERS: how many read at once (each about 80 MB while it runs)
# TOP_VIEW_WORKERS=2

# Telegram: alerts with photos, commands, daily and monthly reports, outage messages (src/telegram).
# Only ONE program may use a bot token: with two, every alert goes out twice and commands get lost.
# TELEGRAM_BOT_TOKEN=
# Admins: the only users whose commands work; they get the reports and health messages. Comma-separated.
# ADMIN_IDS=
# Alert recipients besides those added with /ulash (groups) and /qoshish (users). Comma-separated.
# TELEGRAM_CHAT_IDS=
# TELEGRAM_ALL_VEHICLES=0 sends alerts for GPS vehicles only
# Daily report time (empty: off) and who gets it: admins, groups (admins + alert groups) or all (+ users)
# REPORT_TIME=22:00
# REPORT_TO=groups

# The yard: circle used to tell "in the yard" from GPS (centre from parked trucks' positions, 3 Nov 2026)
YARD_LAT=41.2655
YARD_LNG=69.3418
YARD_RADIUS_M=150
YARD_NAME=TBB hovli

# Health monitor (src/health.js): tells "plant internet down" from "NVR off".
# SITE_ROUTER: host:port that the plant's ROUTER ITSELF answers from the internet (e.g. its web admin or VPN
# port on the same public IP as the NVR). Optional; without it a silent plant is reported as "internet, power
# or NVR" together.
# SITE_ROUTER=87.192.249.151:8291
# Hosts used to check this server's own internet (any one answering is enough)
# INTERNET_PROBES=1.1.1.1:443,8.8.8.8:53

# Alert thresholds
SPEED_LIMIT_KMH=80
OFFLINE_MINUTES=30
LONG_STOP_MINUTES=90
WORK_HOURS=06:00-22:00

# Web Push. Keys are generated on the first start and kept in the database; set them here only to pin them.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tbb-gps.uz

# Development only: simulated GPS and cameras (demo users owner/owner12345, dispatcher/dispatcher123)
# MOCK=1
